{
  "name": "windows-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for Windows Explorer challenge",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/frontend\" \"npm run dev -w apps/backend\"",
    "dev:fe": "npm run dev -w apps/frontend",
    "dev:be": "npm run dev -w apps/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
